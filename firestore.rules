rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    // Staff doc IDs are expected to equal the caller's Firebase Auth uid —
    // same assumption the Cloud Functions make (see functions/lib/auth.js).
    function staffDoc(restaurantId) {
      return get(/databases/$(database)/documents/restaurants/$(restaurantId)/staff/$(request.auth.uid));
    }

    function hasRole(restaurantId, roles) {
      return isSignedIn() && staffDoc(restaurantId).data.role in roles;
    }

    function isStaff(restaurantId) {
      return hasRole(restaurantId, ['waiter', 'chef', 'manager']);
    }

    function isManager(restaurantId) {
      return hasRole(restaurantId, ['manager']);
    }

    // "This field can't change on update" — shared by dishes.available,
    // ingredients.currentStock, and tables.status below.
    function unchanged(field) {
      return request.resource.data[field] == resource.data[field];
    }

    match /restaurants/{restaurantId} {
      // Public info (name, service charge %, GST %) — the menu page needs it
      // and there's nothing sensitive in it.
      allow read: if true;
      allow write: if isManager(restaurantId);

      match /dishes/{dishId} {
        // Public menu — guests and members need to see it with no login.
        allow read: if true;
        allow create: if isManager(restaurantId);
        // `available` is computed by addOrderItem/cancelOrderItem transactions
        // only — a manager can edit the rest of a dish (name, price, ...) but
        // can't hand-flip availability.
        allow update: if isManager(restaurantId) && unchanged('available');
        allow delete: if isManager(restaurantId);
      }

      match /ingredients/{ingredientId} {
        // Raw stock counts are a staff concern, not public.
        allow read: if isStaff(restaurantId);
        allow create: if isManager(restaurantId);
        // currentStock only ever changes via addOrderItem/cancelOrderItem —
        // a manager can rename/re-unit/adjust the low-stock threshold, but
        // can't hand-edit the stock count itself.
        allow update: if isManager(restaurantId) && unchanged('currentStock');
        allow delete: if isManager(restaurantId);
      }

      match /tables/{tableId} {
        // Table map is a staff tool, not customer-facing.
        allow read: if isStaff(restaurantId);
        allow create: if isManager(restaurantId);
        // `status`/`seatedAt` only change via seatTable/closeOrder/
        // markTableClean — a manager can fix a table's number/capacity but
        // can't hand-edit its lifecycle state.
        allow update: if isManager(restaurantId) && unchanged('status');
        allow delete: if isManager(restaurantId);
      }

      match /orders/{orderId} {
        // Orders carry money + stock-linked state (items, totalAmount) that
        // must stay consistent with the ingredient transactions — no direct
        // client writes at all, even for a manager. Every mutation goes
        // through addOrderItem / advanceOrderItemStatus / cancelOrderItem /
        // closeOrder.
        allow read: if isStaff(restaurantId);
        allow write: if false;
      }

      match /staff/{staffId} {
        // Any staff member can see the roster (e.g. who's clocked in); only
        // a manager manages accounts/roles. One exception: a staff member
        // can clock themself in/out (flip their own clockedIn) without a
        // manager doing it for them — everything else about their own doc
        // (name, email, role) still has to stay put.
        allow read: if isStaff(restaurantId);
        allow update: if isManager(restaurantId)
          || (isStaff(restaurantId) && request.auth.uid == staffId
              && unchanged('name') && unchanged('email') && unchanged('role'));
        allow create, delete: if isManager(restaurantId);
      }

      match /members/{memberId} {
        allow read: if isStaff(restaurantId) || (isSignedIn() && request.auth.uid == memberId);
        allow create, update: if isSignedIn() && request.auth.uid == memberId;
        allow delete: if isManager(restaurantId);
      }

      match /queue/{entryId} {
        // Guests check in with no login (per spec: "Guest ... queue check-in") —
        // but still require a sane party size and that they're not checking
        // themselves in as already-seated.
        allow read: if true;
        allow create: if request.resource.data.partySize is number
          && request.resource.data.partySize > 0
          && request.resource.data.partySize <= 20
          && request.resource.data.status == 'waiting';
        allow update, delete: if isStaff(restaurantId);
      }
    }
  }
}
